// ============================================================
// EVENT MARKETPLACE — MVP SCHEMA
// Vendor-signup-first, budget-driven event scoping,
// per-vendor bookings (no pooled/split payments at MVP),
// Salesforce-style Lead -> Opportunity -> Account -> Closed funnel.
// ============================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  PARTNER
  CUSTOMER
}

enum EventStatus {
  LEAD          // scoping in progress, no commitment yet
  OPPORTUNITY   // fully scoped, cost estimate locked, not yet paid
  ACTIVE        // at least one booking is PAID or further
  COMPLETE      // event date has passed
  ABANDONED     // inactive X days with no payment, never converted
}

enum EventType {
  SINGLE_VENDOR
  MULTI_VENDOR
}

enum BookingStatus {
  PLANNED               // added to event, not yet committed to payment
  AWAITING_PAYMENT       // customer has started checkout for this booking
  PAID                   // payment captured, awaiting vendor confirmation
  CONFIRMED               // vendor accepted; both sides confirmed, calendar invites sent
  CLOSED_WON              // event/booking completed successfully
  CLOSED_LOST              // never converted from PLANNED (event abandoned)
  CLOSED_CANCELLED_CLIENT // client cancelled per vendor's stated policy
  CLOSED_CANCELLED_VENDOR // vendor-initiated cancellation, auto-refund + penalty
  CLOSED_RESCHEDULED       // date changed, carried forward to a new booking
  CLOSED_REFUNDED          // catch-all refund outside the above (goodwill/dispute)
}

enum GuestRole {
  ORGANIZER_PAYER
  ATTENDEE
}

enum DepositType {
  FLAT
  PERCENTAGE
}

enum VendorStatusAction {
  APPROVED
  HIDDEN
  UNHIDDEN
  SUSPENDED
}

enum PenaltyReason {
  VENDOR_CANCELLATION
  OTHER
}

enum PenaltyStatus {
  PENDING       // logged, not yet deducted
  DEDUCTED      // pulled from a future payout
  WAIVED        // admin override
}

// ------------------------------------------------------------
// CORE USERS
// ------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  partnerProfile PartnerProfile?
  events         Event[]
  statusLogsMade VendorStatusLog[] @relation("AdminActor")
}

// ------------------------------------------------------------
// VENDOR / PARTNER SIDE
// ------------------------------------------------------------

model PartnerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  companyName     String
  kvkNumber       String   // required — gates approval, not optional
  vatNumber       String   // required — gates approval, not optional
  category        String   // e.g. "CATERER", "DJ", "VENUE", "PHOTOGRAPHER"
  stripeAccountId String?  // populated once Stripe Connect onboarding completes

  hasLiabilityInsurance Boolean @default(false)
  insuranceDocUrl       String?

  isApproved Boolean @default(false) // admin-gated: can list packages
  isVisible  Boolean @default(true)  // approved-but-hidden distinct from never-approved

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  packages        Package[]
  statusLogs      VendorStatusLog[]
  penalties       VendorPenalty[]
  bookings        Booking[]
}

// Audit trail for admin actions on vendor visibility/approval
model VendorStatusLog {
  id        String              @id @default(cuid())
  partnerId String
  action    VendorStatusAction
  reason    String              @db.Text
  adminId   String
  createdAt DateTime            @default(now())

  partner PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  admin   User           @relation("AdminActor", fields: [adminId], references: [id])
}

// Ledger of penalty charges against a vendor (e.g. vendor-cancellation fee)
model VendorPenalty {
  id          String        @id @default(cuid())
  partnerId   String
  bookingId   String?       @unique
  amount      Decimal       @db.Decimal(10, 2)
  reason      PenaltyReason
  status      PenaltyStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?

  partner PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  booking Booking?        @relation(fields: [bookingId], references: [id])
}

// ------------------------------------------------------------
// PACKAGES, TAGS, CANCELLATION POLICY
// ------------------------------------------------------------

model Package {
  id          String   @id @default(cuid())
  partnerId   String
  title       String
  description String   @db.Text
  basePrice   Decimal  @db.Decimal(10, 2)
  maxGuests   Int
  mediaUrls   String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  partner            PartnerProfile      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  tagMappings        PackageTag[]
  bookings           Booking[]
  cancellationPolicy CancellationPolicy?
}

// Vendor-defined commercial terms — structured, not free text,
// so refunds can eventually be calculated automatically.
model CancellationPolicy {
  id        String      @id @default(cuid())
  packageId String      @unique

  depositType         DepositType
  depositValue        Decimal     @db.Decimal(10, 2) // flat amount OR percentage, per depositType
  depositDescription  String      @db.Text            // vendor's own language, shown at checkout
  // e.g. "covers ingredient costs", "secures the date"

  // Simple tiered refund rule set. Kept flexible via JSON for MVP;
  // can be normalized into its own model once patterns stabilize.
  refundTiers Json
  // e.g. [{ "daysBeforeEvent": 14, "refundPercent": 100 },
  //       { "daysBeforeEvent": 7,  "refundPercent": 50  },
  //       { "daysBeforeEvent": 0,  "refundPercent": 0   }]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique // e.g. "Winter", "Bachelorette", "Netherlands"
  type     String       // "SEASON" | "OCCASION" | "REGION" | "DEMOGRAPHIC" | "PRICE_TIER"
  packages PackageTag[]
}

model PackageTag {
  packageId String
  tagId     String

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([packageId, tagId])
}

// ------------------------------------------------------------
// EVENT (the customer's project) + BOOKINGS (per-vendor)
// ------------------------------------------------------------

model Event {
  id         String      @id @default(cuid())
  customerId String?     // nullable: scoping can start before account creation
  title      String      // e.g. "Sarah's Bachelorette Party"
  eventType  String      // occasion tag, e.g. "BACHELORETTE", "CORPORATE_CHRISTMAS"
  eventDate  DateTime
  region     String
  guestCount Int

  budgetTotal      Decimal? @db.Decimal(10, 2)
  budgetPerPerson  Decimal? @db.Decimal(10, 2)
  payingGuestCount Int?     // how many people are contributing financially

  status EventStatus @default(LEAD)
  type   EventType   @default(SINGLE_VENDOR) // auto-set once 2nd booking added

  shareToken String  @unique @default(cuid()) // view-only public link
  isPublic   Boolean @default(true)           // controls whether shareToken is browsable

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer User?     @relation(fields: [customerId], references: [id])
  bookings Booking[]
}

model Booking {
  id        String        @id @default(cuid())
  eventId   String
  packageId String
  partnerId String

  status BookingStatus @default(PLANNED)

  pricePaid Decimal? @db.Decimal(10, 2) // snapshot at time of payment, null while PLANNED
  currency  String   @default("EUR")

  stripePaymentIntentId String?
  stripeTransferId      String? // set once payout to vendor is released (post reserve window)

  // Reserve/holdback mechanics — funds aren't released to vendor
  // immediately on PAID, enabling automatic penalty enforcement.
  payoutReleaseAt DateTime?
  payoutReleased  Boolean   @default(false)

  vendorConfirmedAt      DateTime?
  vendorResponseDeadline DateTime? // 24-48h window after PAID

  rescheduledFromId String?  @unique // self-relation for CLOSED_RESCHEDULED chains
  rescheduledFrom    Booking? @relation("BookingReschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo      Booking? @relation("BookingReschedule")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  package Package        @relation(fields: [packageId], references: [id])
  partner PartnerProfile @relation(fields: [partnerId], references: [id])

  guests        BookingGuest[]
  vendorPenalty VendorPenalty?
}

// Lead booker + attendees, so vendor and platform have full contact visibility
model BookingGuest {
  id        String    @id @default(cuid())
  bookingId String
  email     String
  role      GuestRole @default(ATTENDEE)
  createdAt DateTime  @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, email])
}
